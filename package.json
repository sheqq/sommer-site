{
  "name": "sommer-site",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run generate",
    "build": "next build",
    "prebuild": "npm run generate",
    "start": "next start",
    "generate": "openapi --input ./docs/api/sommer-facade.yaml --output ./src/generated/api --client fetch --name SommerFacadeClient",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run generate"
  },
  "dependencies": {
    "mongodb": "^6.20.0",
    "next": "^15.5.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.9",
    "openapi-typescript-codegen": "^0.29.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
